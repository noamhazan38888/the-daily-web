<% const content = article.published; %>
<%- include('../partials/header', { title: content.title, description: content.summary || content.title }) %>
<div class="columns">
  <div class="main-column">

    <article class="panel full-article">
      <a href="/">← חזרה לחדשות</a>
      <p class="category"><%= content.category %></p>
      <h1><%= content.title %></h1>
      <p class="meta">מאת <%= article.reporter?.displayName || article.reporter?.username || 'מערכת האתר' %>
        <% if (article.publishedAt) { %> · <time datetime="<%= new Date(article.publishedAt).toISOString() %>"><%= formatDate(article.publishedAt) %></time><% } %>
      </p>
      <%- include('../partials/content', { content }) %>
    </article>

    <section class="panel comments-section" id="comments"
             data-article-id="<%= article._id %>">
      <h2>תגובות (<span id="comment-count"><%= comments.length %></span>)</h2>

      <div id="comments-list">
        <% comments.forEach((comment) => { %>
          <article class="comment" id="comment-<%= comment._id %>">
            <p class="comment-meta">
              <strong><%= comment.author?.displayName || comment.author?.username || comment.guestName || 'אורח' %></strong>
              · <time datetime="<%= new Date(comment.createdAt).toISOString() %>"><%= formatDate(comment.createdAt) %></time>
            </p>
            <p><%= comment.body %></p>
          </article>
        <% }); %>
        <% if (!comments.length) { %>
          <p id="no-comments-msg" class="meta">היה הראשון להגיב!</p>
        <% } %>
      </div>

      <div class="comment-form-wrap">
        <h3>הוספת תגובה</h3>
        <noscript><p class="notice">שליחת תגובות דורשת הפעלת JavaScript.</p></noscript>
        <form class="stack-form" id="comment-form">
          <% if (!user) { %>
            <label for="guest-name">שם (אורח)</label>
            <input id="guest-name" name="guestName" maxlength="80" placeholder="אורח" dir="auto">
          <% } %>
          <label for="comment-body">תגובה</label>
          <textarea id="comment-body" name="body" required maxlength="2000" rows="4"
                    placeholder="כתוב את תגובתך כאן…"></textarea>
          <button type="submit">שלח תגובה</button>
          <p class="form-message" id="comment-message" role="status"></p>
        </form>
      </div>
    </section>

  </div>
  <%- include('../partials/sidebar') %>
</div>
<script src="/js/comments.js" defer></script>
<%- include('../partials/footer') %>
