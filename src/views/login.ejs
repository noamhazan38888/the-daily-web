<%- include('partials/header', { title: 'כניסת צוות' }) %>
<section class="panel login-panel">
  <h1>כניסת צוות</h1>
  <p class="meta">התחברות לאזור הכתבים והעורכים</p>
  <% if (error) { %><p class="notice" role="alert"><%= error %></p><% } %>
  <form class="stack-form" method="post" action="/api/auth/login">
    <label for="username">שם משתמש</label><input id="username" name="username" required autocomplete="username" dir="auto">
    <label for="password">סיסמה</label><input id="password" type="password" name="password" required autocomplete="current-password">
    <button type="submit">התחברות</button>
  </form>
</section>
<%- include('partials/footer') %>
